{
  "manifest_version": 3,
  "name": "Mattermost Quote Reply",
  "version": "1.0.0",
  "description": "Adds a 'Quote reply' button to Mattermost messages that inserts a markdown quote of the message into the reply box.",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mattermost-quote-reply@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.platform.sotoon.ir/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
